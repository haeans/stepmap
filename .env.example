# 이 파일을 .env.local로 복사해 값을 채운다. .env.local은 저장소에 올리지 않는다.
# Vercel에는 같은 이름으로 환경 변수를 등록한다.

# --- Supabase (v0.1~) ---
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 마이그레이션 전용 DB 접속 주소. Connect > Session pooler 주소 (drizzle-kit만 사용, 앱 코드에서는 쓰지 않음)
DATABASE_URL=

# --- 개발용 로그인 (로컬 개발 전용 · decisions.md B3, B27) ---
# 로컬 개발에서만 true. Vercel에는 등록하지 않는다(배포본에서는 값이 있어도 항상 꺼진다).
DEV_LOGIN=
DEV_OWNER_EMAIL=
DEV_OWNER_PASSWORD=
DEV_VIEWER_EMAIL=
DEV_VIEWER_PASSWORD=

# --- Google Maps (v0.5~) ---
# 브라우저 지도 표시용 (배포 도메인으로 제한)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# 고급 핀용 지도 ID (없으면 개발용 DEMO_MAP_ID)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# 서버 지오코딩·경로 계산용
GOOGLE_MAPS_SERVER_KEY=

# --- AI 추출 (v0.6~) ---
# 붙여넣기 추출·대화 도우미. Claude 키가 있으면 Claude(claude-sonnet-5-5) 먼저, 실패하거나 없으면 Gemini (C10 F33).
# 둘 다 서버에서만 쓴다. Claude 키는 haeans가 보안 공유로 준다(B30).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- 대표 이미지 (F08) ---
# Unsplash 앱의 Access Key. 서버에서만 쓴다. 없으면 자동 대표 이미지를 건너뛴다.
UNSPLASH_ACCESS_KEY=
